# ClearRouter — Production Environment
# Copy to .env.production and fill in real values.
# The backend loads this file automatically when APP_ENV=production or GIN_MODE=release.

# Database (PostgreSQL / Neon)
DATABASE_URL=postgres://user:password@host:5432/clearrouter?sslmode=require

# Security
JWT_SECRET=change-me-to-a-long-random-string
GIN_MODE=release

# Public URLs
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# OAuth — Google
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/google/callback
GOOGLE_API_KEY=xxx

# OAuth — GitHub
GITHUB_CLIENT_ID=xxx
GITHUB_CLIENT_SECRET=xxx
GITHUB_REDIRECT_URI=https://api.yourdomain.com/auth/github/callback

# Payments — Razorpay
RAZORPAY_key_id=rzp_test_xxx
RAZORPAY_key_secret=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Email — Resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=ClearRouter <noreply@yourdomain.com>

# LLM providers (at least one)
OPENAI_API_KEY=sk-xxx

# Frontend build (Vercel)
VITE_BACKEND_URL=https://api.yourdomain.com
